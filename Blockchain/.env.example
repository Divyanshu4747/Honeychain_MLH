# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file. It is already listed in .gitignore.

# --- Local development (hardhat node) ---
# Default hardhat node accounts already work without any secrets.

# --- Testnet deployment (e.g. Sepolia) ---
# RPC endpoint from a provider such as Infura / Alchemy / a public RPC.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the deployer wallet. Use a DEDICATED throwaway testnet wallet.
# NEVER use a wallet that holds real funds. NEVER commit this value.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key_here

# Optional: block explorer API key for contract verification (e.g. Etherscan).
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- IPFS ---
# Pinning service (e.g. Pinata / web3.storage) used by src/ipfs to pin
# lab certificates and get back a CID. Only the CID is ever written on-chain.
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=your_ipfs_api_key_here
IPFS_API_SECRET=your_ipfs_api_secret_here
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# --- Backend integration ---
# Address of the deployed HoneyChain contract (filled in after deployment).
HONEYCHAIN_CONTRACT_ADDRESS=

# RPC URL the backend uses at runtime (local or testnet).
BACKEND_RPC_URL=http://127.0.0.1:8545
